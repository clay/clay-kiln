{
  "name": "clay-kiln",
  "version": "10.2.3",
  "description": "Editor tools for Clay",
  "template": "template.handlebars",
  "scripts": {
    "lint": "eslint --quiet --ext .js,.vue edit.js view.js view-public.js directives inputs lib test",
    "lint:warnings": "eslint --ext .js,.vue edit.js view.js view-public.js directives inputs lib test",
    "lint:fix": "eslint --fix --ext .js,.vue edit.js view.js view-public.js directives inputs lib test",
    "lint:stats": "eslint --format node_modules/eslint-stats/byErrorandWarning.js --ext .js,.vue edit.js view.js view-public.js directives inputs lib test",
    "jest": "jest",
    "test": "npm run lint && BABEL_ENV=test npm run jest -- --coverage --no-cache",
    "test-local": "BABEL_ENV=test npm run jest -- --watch",
    "build": "node scripts/build.js",
    "watch": "node scripts/build.js --watch",
    "prepublishOnly": "npm run build && npm run test:dist",
    "generate-actions": "jsdoc2md --files lib/**/actions.js > docs/vuex-actions.md",
    "release": "./.circleci/scripts/release.sh",
    "build:prod": "node scripts/build.js --prod",
    "test:dist": "node scripts/smoke-test.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/clay/clay-kiln.git"
  },
  "keywords": [
    "clay",
    "kiln",
    "editor"
  ],
  "author": "New York Media",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/clay/clay-kiln/issues"
  },
  "main": "model.js",
  "files": [
    "dist",
    "media",
    "template.handlebars",
    "schema.yml",
    "bootstrap.yml",
    "model.js"
  ],
  "pre-commit": [
    "lint"
  ],
  "jest": {
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "pretendToBeVisual": true,
      "url": "http://domain.com/_pages/test-page.html?edit=true"
    },
    "setupFiles": [
      "<rootDir>/test/setupFile.js"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "vue"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/__mocks__/fileMock.js",
      "\\.(css|less)$": "<rootDir>/__mocks__/styleMock.js",
      "keen/(.*)$": "<rootDir>/node_modules/keen-ui/src/$1.vue"
    },
    "transform": {
      "^.+\\.js$": "babel-jest",
      ".*\\.(vue)$": "<rootDir>/test/vue-transform.js",
      "\\.hbs$": "<rootDir>/test/hbs-transform.js"
    },
    "transformIgnorePatterns": [
      "<rootDir>/node_modules/(?!(keen-ui|clayhandlebars)/)"
    ],
    "collectCoverageFrom": [
      "<rootDir>/lib/**/*.{js,vue}",
      "<rootDir>/inputs/**/*.{js,vue}",
      "!<rootDir>/lib/utils/api.js"
    ],
    "coverageReporters": [
      "lcov",
      "text-summary"
    ]
  },
  "homepage": "https://github.com/clay/clay-kiln",
  "dependencies": {
    "clayhandlebars": "^5.0.1",
    "js-base64": "^3.7.5"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@nymag/cid": "^1.0.1",
    "@nymag/dom": "^1.3.1",
    "@vue/component-compiler-utils": "3.3.0",
    "@vue/test-utils": "^1.0.0-beta.16",
    "@vue/vue2-jest": "29.2.6",
    "autoprefixer": "^10.4.20",
    "babel-jest": "29.7.0",
    "babel-plugin-lodash": "3.3.4",
    "caret-position": "0.0.1",
    "chrono-node": "^1.3.5",
    "clay-log": "1.3.0",
    "clayutils": "^3.0.0",
    "codemirror": "^5.31.0",
    "coveralls": "^3.0.0",
    "csvjson": "^4.3.4",
    "cuid": "^1.3.8",
    "date-fns": "^1.29.0",
    "delegate": "^3.1.2",
    "element-client-rect": "^1.0.4",
    "eslint": "^5.16.0",
    "eslint-config-airbnb-base": "^13.1.0",
    "eslint-plugin-html": "^3.2.2",
    "eslint-plugin-import": "^2.18.0",
    "eslint-stats": "^1.0.1",
    "fuse.js": "^3.2.0",
    "hash-sum": "^1.0.2",
    "he": "^1.1.1",
    "html-tags": "^2.0.0",
    "intersection-observer": "^0.5.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jsdoc-to-markdown": "^3.0.1",
    "jsdom": "30.1.1",
    "keen-ui": "^1.0.2",
    "keycode": "^2.1.8",
    "localforage": "^1.5.3",
    "lodash": "4.17.13",
    "node-quill-converter": "^0.3.1",
    "nouislider": "^12.0.0",
    "nprogress": "^0.2.0",
    "path-to-regexp": "^3.0.0",
    "postcss": "8.4.49",
    "pre-commit": "^1.2.2",
    "promise-queue": "^2.2.3",
    "querystringify": "2.1.0",
    "quill": "^1.3.3",
    "quill-delta": "^3.6.2",
    "rimraf": "^2.6.2",
    "routable": "0.0.5",
    "sanitize-html": "^1.14.1",
    "sass": "1.77.8",
    "set-dom": "^7.4.5",
    "snarkdown": "^1.2.2",
    "sortablejs": "^1.8.1",
    "speakingurl": "^14.0.1",
    "striptags": "^3.1.0",
    "url-parse": "1.4.4",
    "velocity-animate": "^1.5.0",
    "vite": "8.3.5",
    "vite-plugin-node-polyfills": "0.28.0",
    "vue": "^2.5.9",
    "vue-async-computed": "^3.3.1",
    "vue-avatar": "^2.1.1",
    "vue-click-outside": "^1.0.7",
    "vue-nprogress": "^0.1.5",
    "vue-observe-visibility": "^0.3.1",
    "vue-template-compiler": "^2.5.9",
    "vuex": "^3.0.0",
    "whatwg-fetch": "^2.0.3"
  },
  "peerDependencies": {
    "amphora": "8",
    "amphora-search": "8",
    "handlebars": "4"
  },
  "overrides": {
    "whatwg-encoding": "1.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
